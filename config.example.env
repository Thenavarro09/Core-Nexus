# Copia este archivo a config.env en la raíz del repositorio.
# config.env contiene credenciales y no se versiona.
#
# Estos valores alimentan GET /api/databases.
# La pantalla de Conexiones puede probar otra instancia sin modificar este archivo.

SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=master
# windows usa la sesión actual de Windows. sql usa SQL_USER y SQL_PASSWORD.
SQL_AUTH=windows
SQL_USER=
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUST_SERVER_CERTIFICATE=yes
